#!/usr/bin/env bash
# Opens/closes the Uix window. If it isn't running yet (or is stuck), starts it again.
dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# -k 1: if qs doesn't exit on the normal signal, it is killed
if ! timeout -k 1 3 qs -p "$dir" ipc call uix toggle >/dev/null 2>&1; then
    # No answer: kill whatever is left (even if stuck) and start from scratch
    timeout -k 1 3 qs -p "$dir" kill >/dev/null 2>&1
    pkill -9 -fx "qs -p $dir -n -d" 2>/dev/null
    pkill -9 -f "qs -p $dir ipc call uix" 2>/dev/null
    mkdir -p "$HOME/.config/uix"
    qs -p "$dir" -n -d
fi
