# Bar X — machine-specific settings. Copy to ".env" and edit:  cp .env.example .env
# ".env" is in .gitignore, so your personal values never go to the repository.
# Real environment variables with the same names take priority over this file.

# Command run by the menu button (☰) on the bar instead of the Bar X menu. Empty = the Bar X menu.
# Example: UIX_LAUNCHER="wofi --show drun"
UIX_LAUNCHER=""

# Terminal for apps that run in a terminal (Terminal=true), opened from the Bar X menu. Default: kitty
# Example: UIX_TERMINAL="foot"
UIX_TERMINAL=""

# Command run when you click RAM on the bar (a system monitor). Empty = no action.
# Example: UIX_SYSTEM_MONITOR="kitty -e btop"
UIX_SYSTEM_MONITOR=""
